# Dev-only switch. With DEBUG unset or false the app REFUSES TO START while
# FDM_SECRET_KEY / JWT_SECRET are still the placeholders below — generate real
# values first (commands in the comments). `make dev` sets DEBUG=true itself;
# never set it in production.
DEBUG=false

# Platform database (docker-compose.dev.yml defaults)
DATABASE_URL=postgresql+psycopg://fdm:fdm@localhost:5432/fdm

# Redis (jobs queue + pub/sub)
REDIS_URL=redis://localhost:6379/0

# Master encryption key for secrets at rest (Fernet).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FDM_SECRET_KEY=change-me-generate-a-fernet-key

# Secret used to sign JWT access/refresh tokens (HS256). MUST be at least
# 32 bytes (RFC 7518 §3.2); the placeholder below is 28 bytes and the app
# refuses to start with it unless DEBUG=true. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-long-random-string

# Comma-separated list of allowed browser origins (the Vite dev server in dev)
CORS_ORIGINS=http://localhost:5173

# Default display timezone (timestamps are stored UTC)
DEFAULT_TZ=Asia/Dubai

# Log level for the structured JSON logger (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Session cookies carry the Secure flag by default (HTTPS only). Set to false
# ONLY for plain-HTTP dev (e.g. browsing the dev VM by IP), never in production.
COOKIE_SECURE=true

# Login throttling: the Nth consecutive failure locks that (email, IP) pair
# for LOGIN_LOCKOUT_SECONDS.
LOGIN_LOCKOUT_THRESHOLD=6
LOGIN_LOCKOUT_SECONDS=600
